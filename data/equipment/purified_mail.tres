[ext_resource type="Script" path="res://resources/abilities/status_immunity_ability.gd" id="2_immune"]
[ext_resource type="Script" path="res://resources/equipment_data.gd" id="9_item"]

[sub_resource type="Resource" id="Resource_purif0"]
