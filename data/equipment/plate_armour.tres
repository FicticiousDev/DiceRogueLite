[ext_resource type="Script" path="res://resources/abilities/extra_die_ability.gd" id="2_extra"]
[ext_resource type="Script" path="res://resources/equipment_data.gd" id="9_item"]

[sub_resource type="Resource" id="Resource_plate0"]
