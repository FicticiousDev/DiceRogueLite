[gd_resource type="Resource" script_class="EquipmentData" format=3]

[ext_resource type="Script" path="res://resources/abilities/ability.gd" id="1_ability"]
[ext_resource type="Script" path="res://resources/abilities/cure_ability.gd" id="2_cure"]
[ext_resource type="Script" path="res://resources/equipment_data.gd" id="9_item"]

[sub_resource type="Resource" id="Resource_antid0"]
script = ExtResource("2_cure")
id = &"antidote"
display_name = "Antidote"
description = "Once per level, as an action: cure poison."
poison = true
stun = false
uses_per_level = 1

[resource]
script = ExtResource("9_item")
id = &"antidote_charm"
display_name = "Antidote Charm"
slot = 2
abilities = Array[ExtResource("1_ability")]([SubResource("Resource_antid0")])
