[gd_resource type="Resource" script_class="CharacterData" format=3]

[ext_resource type="Script" path="res://resources/abilities/ability.gd" id="1_ability"]
[ext_resource type="Script" path="res://resources/character_data.gd" id="2_character"]
[ext_resource type="Script" path="res://resources/abilities/dash_ability.gd" id="3_dash_ability"]
[ext_resource type="Script" path="res://resources/abilities/evasion_ability.gd" id="4_evasion_ability"]

[sub_resource type="Resource" id="Ability_passive"]
script = ExtResource("4_evasion_ability")
id = &"blur"
display_name = "Blur"
description = "Passive: enemy attacks are twice as likely to miss you."

[sub_resource type="Resource" id="Ability_active"]
script = ExtResource("3_dash_ability")
id = &"rift_step"
display_name = "Rift Step"
description = "Every 3 turns: teleport up to 5 tiles; your next attack this turn is a crit."
active = true
cooldown = 3
use = 3
reach = 5
boosts = Array[StringName]([&"crit"])

[resource]
script = ExtResource("2_character")
id = &"void_dancer"
order = 6
display_name = "Void Dancer"
tint = Color(0.7, 0.55, 1, 1)
abilities = Array[ExtResource("1_ability")]([SubResource("Ability_passive"), SubResource("Ability_active")])
starting_dice = Array[StringName]([&"movement", &"defence", &"attack", &"rift", &"rift"])
starts_unlocked = false
