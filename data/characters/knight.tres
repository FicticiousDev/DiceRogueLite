[gd_resource type="Resource" script_class="CharacterData" format=3]

[ext_resource type="Script" path="res://resources/abilities/ability.gd" id="1_ability"]
[ext_resource type="Script" path="res://resources/character_data.gd" id="2_character"]
[ext_resource type="Script" path="res://resources/abilities/block_attack_ability.gd" id="3_block_attack_ability"]
[ext_resource type="Script" path="res://resources/abilities/defence_bonus_ability.gd" id="4_defence_bonus_ability"]

[sub_resource type="Resource" id="Ability_passive"]
script = ExtResource("4_defence_bonus_ability")
id = &"bulwark"

[sub_resource type="Resource" id="Ability_active"]
script = ExtResource("3_block_attack_ability")
id = &"shield_block"
active = true
cooldown = 3
use = 1

[resource]
script = ExtResource("2_character")
id = &"knight"
order = 0
tint = Color(0.55, 0.75, 1, 1)
abilities = Array[ExtResource("1_ability")]([SubResource("Ability_passive"), SubResource("Ability_active")])
starting_dice = Array[StringName]([&"movement", &"defence", &"attack", &"guardian", &"guardian"])
