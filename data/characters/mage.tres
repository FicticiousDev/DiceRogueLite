[gd_resource type="Resource" script_class="CharacterData" format=3]

[ext_resource type="Script" path="res://resources/abilities/ability.gd" id="1_ability"]
[ext_resource type="Script" path="res://resources/character_data.gd" id="2_character"]
[ext_resource type="Script" path="res://resources/abilities/area_attack_ability.gd" id="3_area_attack_ability"]
[ext_resource type="Script" path="res://resources/abilities/ignore_defence_ability.gd" id="4_ignore_defence_ability"]

[sub_resource type="Resource" id="Ability_passive"]
script = ExtResource("4_ignore_defence_ability")
id = &"arcane"

[sub_resource type="Resource" id="Ability_active"]
script = ExtResource("3_area_attack_ability")
id = &"blast"
active = true
cooldown = 3

[resource]
script = ExtResource("2_character")
id = &"mage"
order = 2
tint = Color(1, 0.7, 1, 1)
attack_range = 3
abilities = Array[ExtResource("1_ability")]([SubResource("Ability_passive"), SubResource("Ability_active")])
starting_dice = Array[StringName]([&"movement", &"defence", &"attack", &"phase", &"phase"])
