[gd_resource type="Resource" script_class="CharacterData" format=3]

[ext_resource type="Script" path="res://resources/abilities/ability.gd" id="1_ability"]
[ext_resource type="Script" path="res://resources/character_data.gd" id="2_character"]
[ext_resource type="Script" path="res://resources/abilities/boost_ability.gd" id="3_boost_ability"]
[ext_resource type="Script" path="res://resources/abilities/range_damage_ability.gd" id="4_range_damage_ability"]

[sub_resource type="Resource" id="Ability_passive"]
script = ExtResource("4_range_damage_ability")
id = &"deadeye"

[sub_resource type="Resource" id="Ability_active"]
script = ExtResource("3_boost_ability")
id = &"armour_piercer"
active = true
cooldown = 3
use = 2

[resource]
script = ExtResource("2_character")
id = &"sniper"
order = 8
tint = Color(0.75, 0.9, 0.6, 1)
attack_range = 5
abilities = Array[ExtResource("1_ability")]([SubResource("Ability_passive"), SubResource("Ability_active")])
starting_dice = Array[StringName]([&"movement", &"defence", &"attack", &"scope", &"scope"])
starts_unlocked = false
