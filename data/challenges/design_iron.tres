[gd_resource type="Resource" script_class="UnlockChallenge" format=3]

[ext_resource type="Script" path="res://resources/unlock_challenge.gd" id="1_challenge"]

[resource]
script = ExtResource("1_challenge")
id = &"design_iron"
description = "Defeat the Warlord (Grasslands boss) 10 times."
